{% extends 'base.html.twig' %}

{% block title %}Gestion des services – Administration – QueueLess{% endblock %}

{% block body %}
<div class="py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a href="{{ path('admin_dashboard') }}">Administration</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Services</li>
                </ol>
            </nav>
            <h2 class="fw-bold mb-0"><i class="bi bi-layers text-primary me-2"></i> Gestion des services (US26)</h2>
        </div>
        <a href="{{ path('admin_service_new') }}" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Créer un nouveau service
        </a>
    </div>

    <div class="card card-shadow bg-white">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">Services configurés <span class="badge bg-secondary ms-1">{{ services|length }}</span></h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Code</th>
                            <th>Nom du service</th>
                            <th>Description</th>
                            <th>Durée estimée</th>
                            <th>Guichets associés</th>
                            <th>Statut</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for service in services %}
                            <tr>
                                <td><span class="badge bg-primary fs-6">{{ service.code }}</span></td>
                                <td class="fw-bold text-dark">{{ service.name }}</td>
                                <td class="text-secondary small" style="max-width: 320px;">
                                    {{ service.description|default('—') }}
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-clock me-1"></i> {{ service.estimatedDurationMinutes }} min
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-info-subtle text-info">
                                        {{ service.counters|length }} guichet(s)
                                    </span>
                                </td>
                                <td>
                                    {% if service.isActive %}
                                        <span class="badge bg-success-subtle text-success">
                                            <i class="bi bi-check-circle me-1"></i> Actif
                                        </span>
                                    {% else %}
                                        <span class="badge bg-secondary-subtle text-secondary">
                                            <i class="bi bi-pause-circle me-1"></i> Inactif
                                        </span>
                                    {% endif %}
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a href="{{ path('app_service_show', {id: service.id}) }}" class="btn btn-outline-secondary" title="Voir public">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a href="{{ path('admin_service_edit', {id: service.id}) }}" class="btn btn-outline-primary" title="Modifier">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <form method="post" action="{{ path('admin_service_toggle_active', {id: service.id}) }}" class="d-inline" onsubmit="return confirm('Basculer le statut de ce service ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('toggle-active-service-' ~ service.id) }}">
                                            <button type="submit" class="btn btn-outline-{{ service.isActive ? 'warning' : 'success' }}" title="{{ service.isActive ? 'Désactiver' : 'Activer' }}">
                                                <i class="bi bi-power"></i>
                                            </button>
                                        </form>
                                        {% if service.counters|length == 0 %}
                                            <form method="post" action="{{ path('admin_service_delete', {id: service.id}) }}" class="d-inline" onsubmit="return confirm('Confirmer la suppression définitive de ce service ?');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete-service-' ~ service.id) }}">
                                                <button type="submit" class="btn btn-outline-danger" title="Supprimer">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="7" class="text-center text-muted p-4">
                                    Aucun service configuré pour le moment.
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
