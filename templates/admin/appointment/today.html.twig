{% extends 'base.html.twig' %}

{% block title %}Rendez-vous du jour – Administration – QueueLess{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a href="{{ path('admin_dashboard') }}">Administration</a></li>
                <li class="breadcrumb-item active" aria-current="page">Rendez-vous du jour</li>
            </ol>
        </nav>
        <h1 class="h3 mb-0 fw-bold text-danger">
            <i class="bi bi-calendar-day me-2"></i>Rendez-vous du jour
        </h1>
        <p class="text-muted mb-0 mt-1">
            <i class="bi bi-calendar3 me-1"></i>
            {{ selectedDate|date('l d F Y') }}
            – {{ appointments|length }} rendez-vous au total
        </p>
    </div>
    <a href="{{ path('admin_dashboard') }}" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Tableau de bord
    </a>
</div>

{# Filters form #}
<div class="card card-shadow mb-4">
    <div class="card-body p-3">
        <form method="GET" action="{{ path('admin_appointments_today') }}" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label for="date" class="form-label fw-semibold small text-muted">Date</label>
                <input type="date" class="form-control" id="date" name="date"
                       value="{{ selectedDate|date('Y-m-d') }}">
            </div>
            <div class="col-md-4">
                <label for="service_id" class="form-label fw-semibold small text-muted">Filtrer par service</label>
                <select class="form-select" id="service_id" name="service_id">
                    <option value="">— Tous les services —</option>
                    {% for service in allServices %}
                        <option value="{{ service.id }}" {{ selectedService and selectedService.id == service.id ? 'selected' : '' }}>
                            {{ service.name }} {{ not service.isActive() ? '(inactif)' : '' }}
                        </option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-danger w-100">
                    <i class="bi bi-funnel me-1"></i>Appliquer les filtres
                </button>
            </div>
        </form>
    </div>
</div>

{# Stats row #}
{% set confirmed = appointments|filter(a => a.status == 'confirmed')|length %}
{% set completed = appointments|filter(a => a.status == 'completed')|length %}
{% set cancelled = appointments|filter(a => a.status == 'cancelled')|length %}
{% set no_show   = appointments|filter(a => a.status == 'no_show')|length %}

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card card-shadow text-center border-success">
            <div class="card-body py-3">
                <div class="fs-2 fw-bold text-success">{{ confirmed }}</div>
                <div class="small text-muted">Confirmés</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card card-shadow text-center border-primary">
            <div class="card-body py-3">
                <div class="fs-2 fw-bold text-primary">{{ completed }}</div>
                <div class="small text-muted">Terminés</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card card-shadow text-center">
            <div class="card-body py-3">
                <div class="fs-2 fw-bold text-secondary">{{ cancelled }}</div>
                <div class="small text-muted">Annulés</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card card-shadow text-center border-danger">
            <div class="card-body py-3">
                <div class="fs-2 fw-bold text-danger">{{ no_show }}</div>
                <div class="small text-muted">Non honorés</div>
            </div>
        </div>
    </div>
</div>

{# Appointments table #}
<div class="card card-shadow">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0 fw-semibold">
            <i class="bi bi-table me-2 text-danger"></i>Liste des rendez-vous
            {% if selectedService %}
                <span class="badge bg-danger ms-2">{{ selectedService.name }}</span>
            {% endif %}
        </h5>
        <span class="badge bg-secondary">{{ appointments|length }} rendez-vous</span>
    </div>
    <div class="card-body p-0">
        {% if appointments is empty %}
            <div class="text-center py-5 text-muted">
                <i class="bi bi-calendar-x fs-1 mb-3 d-block opacity-50"></i>
                <p class="fs-5">Aucun rendez-vous pour ce jour
                    {% if selectedService %} et ce service{% endif %}.</p>
                <a href="{{ path('admin_schedule_index') }}" class="btn btn-outline-danger btn-sm mt-2">
                    <i class="bi bi-clock me-1"></i>Gérer les horaires
                </a>
            </div>
        {% else %}
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="px-4">Référence</th>
                            <th>Client</th>
                            <th>Service</th>
                            <th>Heure début</th>
                            <th>Heure fin</th>
                            <th>Statut</th>
                            <th>Notes</th>
                            <th>Réservé le</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for appointment in appointments %}
                        <tr>
                            <td class="px-4">
                                <code class="bg-light px-2 py-1 rounded text-dark small">
                                    {{ appointment.appointmentReference }}
                                </code>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle bg-danger text-white d-flex align-items-center justify-content-center"
                                         style="width: 32px; height: 32px; font-size: 0.75rem; flex-shrink: 0;">
                                        {{ appointment.client.firstName|first|upper }}{{ appointment.client.lastName|first|upper }}
                                    </div>
                                    <div>
                                        <div class="fw-semibold small">{{ appointment.client.fullName }}</div>
                                        <div class="text-muted" style="font-size: 0.75rem;">{{ appointment.client.email }}</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge {{ appointment.service.isActive() ? 'bg-primary' : 'bg-secondary' }}">
                                    {{ appointment.service.name }}
                                </span>
                            </td>
                            <td class="fw-semibold">
                                <i class="bi bi-clock text-success me-1"></i>
                                {{ appointment.startTime|date('H:i') }}
                            </td>
                            <td class="text-muted">
                                {{ appointment.endTime|date('H:i') }}
                            </td>
                            <td>
                                <span class="badge {{ appointment.statusBadgeClass }}">
                                    {{ appointment.statusLabel }}
                                </span>
                            </td>
                            <td>
                                {% if appointment.notes %}
                                    <span class="text-muted small" title="{{ appointment.notes }}">
                                        <i class="bi bi-sticky me-1"></i>{{ appointment.notes|slice(0, 40) }}{% if appointment.notes|length > 40 %}…{% endif %}
                                    </span>
                                {% else %}
                                    <span class="text-muted small">—</span>
                                {% endif %}
                            </td>
                            <td class="text-muted small">
                                {{ appointment.createdAt|date('d/m à H:i') }}
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
