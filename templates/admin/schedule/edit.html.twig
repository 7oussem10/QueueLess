{% extends 'base.html.twig' %}

{% block title %}Modifier l'horaire – {{ schedule.service.name }} ({{ schedule.dayName }}) – QueueLess{% endblock %}

{% block body %}
<div class="py-3">
    <div class="mb-3">
        <a href="{{ path('admin_schedule_by_service', {id: schedule.service.id}) }}" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Retour aux horaires du service
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card card-shadow bg-white p-4">
                <div class="border-bottom pb-3 mb-4">
                    <span class="badge bg-primary mb-1">{{ schedule.service.code }}</span>
                    <h3 class="fw-bold mb-1">Modifier l'horaire : {{ schedule.dayName }}</h3>
                    <p class="text-muted small mb-0">Service : <strong>{{ schedule.service.name }}</strong></p>
                </div>

                {{ form_start(form) }}
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            {{ form_label(form.openingTime, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.openingTime) }}
                            {{ form_errors(form.openingTime, {'attr': {'class': 'text-danger small mt-1 list-unstyled'}}) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_label(form.closingTime, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.closingTime) }}
                            {{ form_errors(form.closingTime, {'attr': {'class': 'text-danger small mt-1 list-unstyled'}}) }}
                        </div>
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.slotDurationMinutes, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        <div class="input-group">
                            {{ form_widget(form.slotDurationMinutes) }}
                            <span class="input-group-text">minutes</span>
                        </div>
                        {{ form_errors(form.slotDurationMinutes, {'attr': {'class': 'text-danger small mt-1 list-unstyled'}}) }}
                        <div class="form-text small">Définit la périodicité de découpage des créneaux de rendez-vous pour ce jour.</div>
                    </div>

                    <div class="mb-4 form-check form-switch p-3 bg-light rounded ms-0">
                        <div class="ms-4">
                            {{ form_widget(form.isActive) }}
                            {{ form_label(form.isActive, null, {'label_attr': {'class': 'form-check-label fw-bold'}}) }}
                        </div>
                    </div>

                    <div class="d-flex justify-content-between pt-3 border-top">
                        <a href="{{ path('admin_schedule_by_service', {id: schedule.service.id}) }}" class="btn btn-outline-secondary">Annuler</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-lg me-1"></i> Enregistrer
                        </button>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
