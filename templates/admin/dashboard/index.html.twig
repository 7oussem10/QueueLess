{% extends 'base.html.twig' %}

{% block title %}Administration – Tableau de bord – QueueLess{% endblock %}

{% block body %}
<div class="py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <span class="badge bg-danger-subtle text-danger px-3 py-1 rounded-pill mb-1">
                <i class="bi bi-shield-lock-fill me-1"></i> Espace Administrateur
            </span>
            <h2 class="fw-bold mb-0">Tableau de bord de pilotage</h2>
        </div>
        <div class="d-flex gap-2 mt-2 mt-md-0">
            <a href="{{ path('admin_user_index') }}" class="btn btn-outline-dark btn-sm">
                <i class="bi bi-people me-1"></i> Utilisateurs
            </a>
            <a href="{{ path('admin_service_new') }}" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-circle me-1"></i> Nouveau service
            </a>
            <a href="{{ path('admin_counter_new') }}" class="btn btn-success btn-sm">
                <i class="bi bi-plus-circle me-1"></i> Nouveau guichet
            </a>
        </div>
    </div>

    <!-- KPI Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="card card-shadow stat-card p-3 bg-white border-start border-4 border-primary">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase fw-bold">Utilisateurs inscrits</div>
                        <h3 class="fw-bold text-dark mt-1 mb-0">{{ totalUsers }}</h3>
                    </div>
                    <div class="rounded-circle bg-primary-subtle text-primary p-3">
                        <i class="bi bi-people-fill fs-4"></i>
                    </div>
                </div>
                <div class="mt-2 small text-muted">
                    <a href="{{ path('admin_user_index') }}" class="text-decoration-none">Gérer les comptes &rarr;</a>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card card-shadow stat-card p-3 bg-white border-start border-4 border-info">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase fw-bold">Agents opérationnels</div>
                        <h3 class="fw-bold text-dark mt-1 mb-0">{{ agentsCount }}</h3>
                    </div>
                    <div class="rounded-circle bg-info-subtle text-info p-3">
                        <i class="bi bi-headset fs-4"></i>
                    </div>
                </div>
                <div class="mt-2 small text-muted">
                    <a href="{{ path('admin_user_index', {role: 'ROLE_AGENT'}) }}" class="text-decoration-none">Voir les agents &rarr;</a>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card card-shadow stat-card p-3 bg-white border-start border-4 border-success">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase fw-bold">Services actifs</div>
                        <h3 class="fw-bold text-dark mt-1 mb-0">{{ activeServicesCount }} <span class="fs-6 text-muted fw-normal">/ {{ totalServicesCount }}</span></h3>
                    </div>
                    <div class="rounded-circle bg-success-subtle text-success p-3">
                        <i class="bi bi-layers-fill fs-4"></i>
                    </div>
                </div>
                <div class="mt-2 small text-muted">
                    <a href="{{ path('admin_service_index') }}" class="text-decoration-none">Gérer les services &rarr;</a>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card card-shadow stat-card p-3 bg-white border-start border-4 border-warning">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase fw-bold">Guichets ouverts</div>
                        <h3 class="fw-bold text-dark mt-1 mb-0">{{ activeCountersCount }} <span class="fs-6 text-muted fw-normal">/ {{ totalCountersCount }}</span></h3>
                    </div>
                    <div class="rounded-circle bg-warning-subtle text-warning p-3">
                        <i class="bi bi-display-fill fs-4"></i>
                    </div>
                </div>
                <div class="mt-2 small text-muted">
                    <a href="{{ path('admin_counter_index') }}" class="text-decoration-none">Gérer les guichets &rarr;</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick tables -->
    <div class="row g-4">
        <!-- Services table -->
        <div class="col-lg-6">
            <div class="card card-shadow bg-white h-100">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0"><i class="bi bi-layers text-primary me-2"></i> Services configurés</h5>
                    <a href="{{ path('admin_service_index') }}" class="btn btn-sm btn-outline-primary">Tous les services</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th>Code</th>
                                    <th>Nom</th>
                                    <th>Durée</th>
                                    <th>Statut</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for s in services %}
                                    <tr>
                                        <td><span class="badge bg-primary">{{ s.code }}</span></td>
                                        <td class="fw-semibold">{{ s.name }}</td>
                                        <td>{{ s.estimatedDurationMinutes }} min</td>
                                        <td>
                                            {% if s.isActive %}
                                                <span class="badge bg-success-subtle text-success">Actif</span>
                                            {% else %}
                                                <span class="badge bg-secondary-subtle text-secondary">Inactif</span>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr><td colspan="4" class="text-center text-muted p-3">Aucun service</td></tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Counters table -->
        <div class="col-lg-6">
            <div class="card card-shadow bg-white h-100">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0"><i class="bi bi-display text-warning me-2"></i> État des guichets</h5>
                    <a href="{{ path('admin_counter_index') }}" class="btn btn-sm btn-outline-warning">Tous les guichets</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th>Code</th>
                                    <th>Nom</th>
                                    <th>Service</th>
                                    <th>Agent</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for c in counters %}
                                    <tr>
                                        <td><span class="badge bg-dark">{{ c.code }}</span></td>
                                        <td class="fw-semibold">{{ c.name }}</td>
                                        <td>{{ c.service ? c.service.name : '<span class="text-muted">Non assigné</span>'|raw }}</td>
                                        <td>
                                            {% if c.currentAgent %}
                                                <span class="badge bg-info-subtle text-info"><i class="bi bi-person me-1"></i> {{ c.currentAgent.fullName }}</span>
                                            {% else %}
                                                <span class="badge bg-light text-muted border">Inoccupé</span>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr><td colspan="4" class="text-center text-muted p-3">Aucun guichet</td></tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent users -->
        <div class="col-12">
            <div class="card card-shadow bg-white">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0"><i class="bi bi-people text-success me-2"></i> Derniers utilisateurs enregistrés</h5>
                    <a href="{{ path('admin_user_index') }}" class="btn btn-sm btn-outline-secondary">Voir tous les utilisateurs</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th>Nom &amp; Prénom</th>
                                    <th>Email</th>
                                    <th>Rôle</th>
                                    <th>Statut</th>
                                    <th>Date d'inscription</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for u in recentUsers %}
                                    <tr>
                                        <td class="fw-semibold">{{ u.fullName }}</td>
                                        <td><code>{{ u.email }}</code></td>
                                        <td>
                                            <span class="badge {{ u.hasRole('ROLE_ADMIN') ? 'badge-role-admin' : (u.hasRole('ROLE_AGENT') ? 'badge-role-agent' : 'badge-role-client') }}">
                                                {{ u.primaryRoleLabel }}
                                            </span>
                                        </td>
                                        <td>
                                            {% if u.isActive %}
                                                <span class="badge bg-success-subtle text-success"><i class="bi bi-check-circle me-1"></i> Actif</span>
                                            {% else %}
                                                <span class="badge bg-danger-subtle text-danger"><i class="bi bi-x-circle me-1"></i> Inactif</span>
                                            {% endif %}
                                        </td>
                                        <td class="small text-muted">{{ u.createdAt|date('d/m/Y H:i') }}</td>
                                        <td class="text-end">
                                            <a href="{{ path('admin_user_show', {id: u.id}) }}" class="btn btn-sm btn-light border" title="Voir fiche">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a href="{{ path('admin_user_edit', {id: u.id}) }}" class="btn btn-sm btn-light border text-primary" title="Modifier">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr><td colspan="6" class="text-center text-muted p-3">Aucun utilisateur</td></tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
