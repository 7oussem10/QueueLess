<!DOCTYPE html>
<html lang="fr" class="h-100">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}QueueLess – Gestion des files d'attente et des rendez-vous{% endblock %}</title>
    
    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <style>
        :root {
            --ql-primary: #1e3a8a;
            --ql-secondary: #0d9488;
            --ql-accent: #f59e0b;
        }
        body {
            background-color: #f8fafc;
            color: #1e293b;
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        }
        .navbar-brand {
            font-weight: 700;
            letter-spacing: -0.5px;
            color: #1e3a8a !important;
        }
        .badge-role-admin { background-color: #dc2626; color: #fff; }
        .badge-role-agent { background-color: #2563eb; color: #fff; }
        .badge-role-client { background-color: #059669; color: #fff; }
        .card-shadow {
            border: 1px solid rgba(0,0,0,0.06);
            border-radius: 0.75rem;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05), 0 2px 4px -2px rgba(0,0,0,0.05);
        }
        .stat-card {
            border-radius: 0.75rem;
            transition: transform 0.15s ease-in-out;
        }
        .stat-card:hover {
            transform: translateY(-2px);
        }
        .table-hover tbody tr:hover {
            background-color: #f1f5f9;
        }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body class="d-flex flex-column h-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" href="{{ path('app_home') }}">
                    <i class="bi bi-clock-history fs-3 text-primary"></i>
                    <span>QueueLess</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-style"><i class="bi bi-list"></i></span>
                </button>
                
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_home') }}"><i class="bi bi-house me-1"></i> Accueil</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_services_list') }}"><i class="bi bi-grid me-1"></i> Services disponibles</a>
                        </li>
                        
                        {% if is_granted('ROLE_ADMIN') %}
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-danger fw-semibold" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-shield-lock me-1"></i> Administration
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="{{ path('admin_dashboard') }}"><i class="bi bi-speedometer2 me-2"></i> Tableau de bord</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="{{ path('admin_user_index') }}"><i class="bi bi-people me-2"></i> Gestion des utilisateurs</a></li>
                                    <li><a class="dropdown-item" href="{{ path('admin_service_index') }}"><i class="bi bi-layers me-2"></i> Gestion des services</a></li>
                                    <li><a class="dropdown-item" href="{{ path('admin_counter_index') }}"><i class="bi bi-display me-2"></i> Gestion des guichets</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="{{ path('admin_schedule_index') }}"><i class="bi bi-clock me-2"></i> Horaires des services</a></li>
                                    <li><a class="dropdown-item" href="{{ path('admin_appointments_today') }}"><i class="bi bi-calendar-day me-2"></i> Rendez-vous du jour</a></li>
                                </ul>
                            </li>
                        {% endif %}

                        {% if is_granted('ROLE_AGENT') and not is_granted('ROLE_ADMIN') %}
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-primary fw-semibold" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-headset me-1"></i> Espace Agent
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="{{ path('agent_dashboard') }}"><i class="bi bi-speedometer2 me-2"></i> Tableau de bord Agent</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="{{ path('agent_tickets_pending') }}"><i class="bi bi-ticket-perforated me-2"></i> File d'attente</a></li>
                                    <li><a class="dropdown-item" href="{{ path('agent_appointments_today') }}"><i class="bi bi-calendar-day me-2"></i> Rendez-vous du jour</a></li>
                                </ul>
                            </li>
                        {% endif %}

                        {% if is_granted('ROLE_CLIENT') %}
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-success fw-semibold" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle me-1"></i> Mon Espace Client
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="{{ path('client_dashboard') }}"><i class="bi bi-house me-2"></i> Tableau de bord</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="{{ path('client_ticket_request') }}"><i class="bi bi-ticket-perforated me-2"></i> Prendre un ticket</a></li>
                                    <li><a class="dropdown-item" href="{{ path('client_ticket_list') }}"><i class="bi bi-list-check me-2"></i> Mes tickets</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="{{ path('client_appointment_slots') }}"><i class="bi bi-calendar-plus me-2"></i> Prendre un rendez-vous</a></li>
                                    <li><a class="dropdown-item" href="{{ path('client_appointment_index') }}"><i class="bi bi-calendar-check me-2"></i> Mes rendez-vous</a></li>
                                </ul>
                            </li>
                        {% endif %}
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-lg-center gap-2">
                        {% if app.user %}
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; font-size: 0.85rem;">
                                        {{ app.user.firstName|first|upper }}{{ app.user.lastName|first|upper }}
                                    </div>
                                    <span>{{ app.user.fullName }}</span>
                                    <span class="badge {{ is_granted('ROLE_ADMIN') ? 'badge-role-admin' : (is_granted('ROLE_AGENT') ? 'badge-role-agent' : 'badge-role-client') }}">
                                        {{ app.user.primaryRoleLabel }}
                                    </span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    {% if is_granted('ROLE_ADMIN') %}
                                        <li><a class="dropdown-item" href="{{ path('admin_dashboard') }}"><i class="bi bi-speedometer2 me-2"></i> Espace Admin</a></li>
                                    {% elseif is_granted('ROLE_AGENT') %}
                                        <li><a class="dropdown-item" href="{{ path('agent_dashboard') }}"><i class="bi bi-headset me-2"></i> Espace Agent</a></li>
                                    {% else %}
                                        <li><a class="dropdown-item" href="{{ path('client_dashboard') }}"><i class="bi bi-person me-2"></i> Espace Client</a></li>
                                    {% endif %}
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item text-danger" href="{{ path('app_logout') }}">
                                            <i class="bi bi-box-arrow-right me-2"></i> Déconnexion
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        {% else %}
                            <li class="nav-item">
                                <a class="btn btn-outline-primary btn-sm px-3" href="{{ path('app_login') }}">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Connexion
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm px-3" href="{{ path('app_register') }}">
                                    <i class="bi bi-person-plus me-1"></i> Créer un compte
                                </a>
                            </li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-shrink-0 my-4">
        <div class="container">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show card-shadow mb-4" role="alert">
                        {% if label == 'success' %}
                            <i class="bi bi-check-circle-fill me-2"></i>
                        {% elseif label == 'danger' or label == 'error' %}
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        {% elseif label == 'warning' %}
                            <i class="bi bi-exclamation-circle-fill me-2"></i>
                        {% else %}
                            <i class="bi bi-info-circle-fill me-2"></i>
                        {% endif %}
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                    </div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </div>
    </main>

    <footer class="footer mt-auto py-3 bg-white border-top text-center text-muted text-sm">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
            <div>
                <strong>QueueLess</strong> &copy; 2026 – Système de gestion des files d'attente et des rendez-vous.
            </div>
            <div>
                <span class="badge bg-light text-dark border">Symfony 7.4 &bull; PHP 8.3 &bull; MySQL 8.4</span>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5.3 Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>
