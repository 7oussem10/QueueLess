{% extends 'base.html.twig' %}

{% block title %}Détails Ticket {{ ticket.ticketNumber }} – Espace Agent – QueueLess{% endblock %}

{% block body %}
<div class="py-3">
    <div class="mb-3">
        <a href="{{ path('agent_dashboard') }}" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Retour à ma console
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card card-shadow bg-white p-4">
                <div class="border-bottom pb-3 mb-4 d-flex justify-content-between align-items-start">
                    <div>
                        <span class="badge bg-primary mb-2 fs-6">{{ ticket.service.code }}</span>
                        <h3 class="fw-bold mb-1 font-monospace text-primary">{{ ticket.ticketNumber }}</h3>
                        <p class="text-muted small mb-0">{{ ticket.service.name }}</p>
                    </div>
                    <div>
                        <span class="badge {{ ticket.statusBadgeClass }} fs-6 px-3 py-2">
                            {{ ticket.statusLabel }}
                        </span>
                    </div>
                </div>

                <!-- Client information (US17) -->
                <h5 class="fw-bold mb-3"><i class="bi bi-person-fill text-primary me-2"></i> Informations du client</h5>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded">
                            <span class="text-muted small d-block">Nom et Prénom</span>
                            <span class="fw-semibold text-dark">{{ ticket.client.fullName }}</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded">
                            <span class="text-muted small d-block">Email</span>
                            <code>{{ ticket.client.email }}</code>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded">
                            <span class="text-muted small d-block">Téléphone</span>
                            <span class="fw-semibold">{{ ticket.client.phoneNumber|default('Non renseigné') }}</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded">
                            <span class="text-muted small d-block">Guichet assigné</span>
                            <span class="fw-semibold text-primary">{{ ticket.counter ? ticket.counter.name ~ ' (' ~ ticket.counter.code ~ ')' : 'En attente' }}</span>
                        </div>
                    </div>
                </div>

                <!-- Timestamps -->
                <h5 class="fw-bold mb-3"><i class="bi bi-clock-history text-secondary me-2"></i> Historique du traitement</h5>
                <div class="table-responsive small border rounded mb-4">
                    <table class="table table-sm table-borderless mb-0">
                        <tbody>
                            <tr>
                                <th class="text-muted ps-3 py-2">Création du ticket :</th>
                                <td class="py-2">{{ ticket.createdAt|date('d/m/Y à H:i:s') }}</td>
                            </tr>
                            <tr>
                                <th class="text-muted ps-3 py-2">Appelé à :</th>
                                <td class="py-2">{{ ticket.calledAt ? ticket.calledAt|date('d/m/Y à H:i:s') : 'Non encore appelé' }}</td>
                            </tr>
                            <tr>
                                <th class="text-muted ps-3 py-2">Début du traitement :</th>
                                <td class="py-2">{{ ticket.startedAt ? ticket.startedAt|date('d/m/Y à H:i:s') : 'Non encore commencé' }}</td>
                            </tr>
                            <tr>
                                <th class="text-muted ps-3 py-2">Fin du traitement :</th>
                                <td class="py-2">{{ ticket.completedAt ? ticket.completedAt|date('d/m/Y à H:i:s') : 'En cours / En attente' }}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                {% if ticket.notes %}
                    <div class="p-3 bg-light rounded mb-4">
                        <h6 class="fw-bold mb-1">Notes enregistrées :</h6>
                        <p class="small text-secondary mb-0">{{ ticket.notes }}</p>
                    </div>
                {% endif %}

                <div class="pt-3 border-top text-center">
                    <a href="{{ path('agent_dashboard') }}" class="btn btn-primary px-4">
                        <i class="bi bi-arrow-return-left me-1"></i> Retour au tableau de bord
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
