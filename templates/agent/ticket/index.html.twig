{% extends 'base.html.twig' %}

{% block title %}Tickets en attente – Espace Agent – QueueLess{% endblock %}

{% block body %}
<div class="py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a href="{{ path('agent_dashboard') }}">Espace Agent</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Tickets en attente</li>
                </ol>
            </nav>
            <h2 class="fw-bold mb-0"><i class="bi bi-list-ol text-primary me-2"></i> File des tickets en attente (US15)</h2>
        </div>
        <div>
            <a href="{{ path('agent_dashboard') }}" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Retour à ma console
            </a>
        </div>
    </div>

    <!-- Filtre par service (US15) -->
    <div class="card card-shadow bg-white p-3 mb-4">
        <form method="get" action="{{ path('agent_tickets_pending') }}" class="row g-2 align-items-center">
            <div class="col-md-8">
                <label class="form-label small fw-bold mb-1">Filtrer par service :</label>
                <select name="service_id" class="form-select" onchange="this.form.submit()">
                    <option value="">-- Tous les services actifs --</option>
                    {% for s in allServices %}
                        <option value="{{ s.id }}" {{ selectedService and selectedService.id == s.id ? 'selected' : '' }}>
                            {{ s.name }} ({{ s.code }})
                        </option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-4 d-flex align-items-end">
                {% if assignedCounter and not activeTicket and pendingTickets|length > 0 %}
                    <form method="post" action="{{ path('agent_ticket_call_next') }}" class="w-100">
                        <input type="hidden" name="_token" value="{{ csrf_token('call-next-ticket') }}">
                        {% if selectedService %}
                            <input type="hidden" name="service_id" value="{{ selectedService.id }}">
                        {% endif %}
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-megaphone-fill me-1"></i> Appeler le suivant (FIFO)
                        </button>
                    </form>
                {% endif %}
            </div>
        </form>
    </div>

    <!-- Table des tickets en attente -->
    <div class="card card-shadow bg-white">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">
                Tickets en file d'attente
                <span class="badge bg-secondary ms-1">{{ pendingTickets|length }}</span>
            </h5>
            <small class="text-muted"><i class="bi bi-sort-numeric-down me-1"></i> Ordre chronologique strict (FIFO)</small>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Ordre</th>
                            <th>Numéro</th>
                            <th>Service</th>
                            <th>Client</th>
                            <th>Date / Heure de création</th>
                            <th>Statut</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for t in pendingTickets %}
                            <tr class="{{ loop.first ? 'table-warning' : '' }}">
                                <td>
                                    {% if loop.first %}
                                        <span class="badge bg-warning text-dark"><i class="bi bi-arrow-right"></i> Prochain (FIFO)</span>
                                    {% else %}
                                        <span class="badge bg-light text-dark border">#{{ loop.index }}</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <span class="font-monospace fw-bold text-primary fs-6">{{ t.ticketNumber }}</span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">{{ t.service.code }}</span>
                                    {{ t.service.name }}
                                </td>
                                <td class="fw-semibold">
                                    {{ t.client.fullName }}
                                </td>
                                <td class="small text-muted">
                                    {{ t.createdAt|date('d/m/Y à H:i:s') }}
                                </td>
                                <td>
                                    <span class="badge {{ t.statusBadgeClass }}">{{ t.statusLabel }}</span>
                                </td>
                                <td class="text-end">
                                    <a href="{{ path('agent_ticket_show', {id: t.id}) }}" class="btn btn-sm btn-outline-secondary" title="Consulter la fiche (US17)">
                                        <i class="bi bi-eye me-1"></i> Fiche
                                    </a>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="7" class="text-center text-muted p-4">
                                    <i class="bi bi-inbox fs-2 d-block mb-1"></i>
                                    Aucun ticket en attente pour ce service.
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
