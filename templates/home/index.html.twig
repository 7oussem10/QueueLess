{% extends 'base.html.twig' %}

{% block title %}Accueil – QueueLess{% endblock %}

{% block body %}
<div class="row align-items-center mb-5 py-4">
    <div class="col-lg-7">
        <span class="badge bg-primary-subtle text-primary mb-2 px-3 py-2 rounded-pill fs-6">
            <i class="bi bi-stars me-1"></i> Système intelligent de gestion d'accueil
        </span>
        <h1 class="display-5 fw-bold text-dark mb-3">
            Gérez vos files d'attente et vos rendez-vous en toute sérénité avec <span class="text-primary">QueueLess</span>
        </h1>
        <p class="lead text-secondary mb-4">
            Optimisez le parcours de vos usagers, réduisez le temps d'attente sur place, facilitez le travail des agents et pilotez les guichets en temps réel.
        </p>
        <div class="d-flex flex-wrap gap-3">
            {% if not app.user %}
                <a href="{{ path('app_register') }}" class="btn btn-primary btn-lg px-4 shadow-sm">
                    <i class="bi bi-person-plus me-2"></i> Créer mon compte client
                </a>
                <a href="{{ path('app_login') }}" class="btn btn-outline-secondary btn-lg px-4">
                    <i class="bi bi-box-arrow-in-right me-2"></i> Se connecter
                </a>
            {% else %}
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('admin_dashboard') }}" class="btn btn-danger btn-lg px-4 shadow-sm">
                        <i class="bi bi-speedometer2 me-2"></i> Accéder au tableau de bord administrateur
                    </a>
                {% elseif is_granted('ROLE_AGENT') %}
                    <a href="{{ path('agent_dashboard') }}" class="btn btn-primary btn-lg px-4 shadow-sm">
                        <i class="bi bi-headset me-2"></i> Accéder à l'espace agent
                    </a>
                {% else %}
                    <a href="{{ path('client_dashboard') }}" class="btn btn-success btn-lg px-4 shadow-sm">
                        <i class="bi bi-person-circle me-2"></i> Accéder à mon espace client
                    </a>
                {% endif %}
            {% endif %}
            <a href="{{ path('app_services_list') }}" class="btn btn-light border btn-lg px-4">
                <i class="bi bi-grid me-2"></i> Voir les services
            </a>
        </div>
    </div>
    <div class="col-lg-5 mt-4 mt-lg-0 text-center">
        <div class="card card-shadow p-4 bg-white">
            <div class="d-flex justify-content-around text-center mb-4">
                <div>
                    <h2 class="fw-bold text-primary mb-0">{{ services|length }}</h2>
                    <small class="text-muted">Services actifs</small>
                </div>
                <div class="vr"></div>
                <div>
                    <h2 class="fw-bold text-success mb-0">{{ countersCount }}</h2>
                    <small class="text-muted">Guichets installés</small>
                </div>
                <div class="vr"></div>
                <div>
                    <h2 class="fw-bold text-warning mb-0"><i class="bi bi-shield-check"></i></h2>
                    <small class="text-muted">Sécurisé</small>
                </div>
            </div>
            <div class="p-3 bg-light rounded text-start">
                <h6 class="fw-bold mb-2"><i class="bi bi-info-circle text-primary me-2"></i> Fonctionnalités clés :</h6>
                <ul class="list-unstyled mb-0 small text-secondary">
                    <li class="mb-1"><i class="bi bi-check2 text-success me-1"></i> Consultation des services en libre accès</li>
                    <li class="mb-1"><i class="bi bi-check2 text-success me-1"></i> Gestion des comptes et attribution des rôles</li>
                    <li class="mb-1"><i class="bi bi-check2 text-success me-1"></i> Émission automatique des tickets et file FIFO</li>
                    <li class="mb-1"><i class="bi bi-check2 text-success me-1"></i> Prise de rendez-vous avec créneaux dynamiques</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">Nos services disponibles</h3>
            <p class="text-muted mb-0">Consultez l'ensemble des prestations ouvertes au public</p>
        </div>
        <a href="{{ path('app_services_list') }}" class="btn btn-outline-primary btn-sm">
            Voir tous les services <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>

    <div class="row g-4">
        {% for service in services %}
            <div class="col-md-4">
                <div class="card card-shadow h-100 border-top border-4 border-primary">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-primary fs-6">{{ service.code }}</span>
                            <span class="badge bg-success-subtle text-success">
                                <i class="bi bi-check-circle me-1"></i> Ouvert
                            </span>
                        </div>
                        <h5 class="card-title fw-bold text-dark mb-2">{{ service.name }}</h5>
                        <p class="card-text text-secondary small flex-grow-1">
                            {{ service.description|default('Aucune description fournie pour ce service.') }}
                        </p>
                        <div class="pt-3 border-top d-flex justify-content-between align-items-center text-muted small">
                            <span><i class="bi bi-clock me-1"></i> ~{{ service.estimatedDurationMinutes }} min</span>
                            <span><i class="bi bi-display me-1"></i> {{ service.activeCounters|length }} guichet(s)</span>
                        </div>
                        <div class="mt-3">
                            <a href="{{ path('app_service_show', {id: service.id}) }}" class="btn btn-outline-primary btn-sm w-100">
                                Détails du service
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <div class="alert alert-info">Aucun service n'est actuellement disponible.</div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
