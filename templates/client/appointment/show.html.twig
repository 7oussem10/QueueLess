{% extends 'base.html.twig' %}

{% block title %}Rendez-vous {{ appointment.appointmentReference }} – QueueLess{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a href="{{ path('client_dashboard') }}">Tableau de bord</a></li>
                <li class="breadcrumb-item"><a href="{{ path('client_appointment_index') }}">Mes rendez-vous</a></li>
                <li class="breadcrumb-item active" aria-current="page">{{ appointment.appointmentReference }}</li>
            </ol>
        </nav>
        <h1 class="h3 mb-0 fw-bold text-success">
            <i class="bi bi-calendar-check me-2"></i>Détails du rendez-vous
        </h1>
    </div>
    <a href="{{ path('client_appointment_index') }}" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Retour à mes rendez-vous
    </a>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card card-shadow">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0 fw-semibold">
                    <i class="bi bi-info-circle me-2 text-success"></i>Informations du rendez-vous
                </h5>
                <span class="badge {{ appointment.statusBadgeClass }} fs-6 px-3 py-2">
                    {{ appointment.statusLabel }}
                </span>
            </div>
            <div class="card-body p-4">
                <dl class="row g-3">
                    <dt class="col-sm-4 text-muted fw-normal">Référence</dt>
                    <dd class="col-sm-8">
                        <code class="fs-6 bg-light px-2 py-1 rounded text-dark">{{ appointment.appointmentReference }}</code>
                    </dd>

                    <dt class="col-sm-4 text-muted fw-normal">Service</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-primary fs-6 px-3 py-2">
                            <i class="bi bi-layers me-1"></i>{{ appointment.service.name }}
                        </span>
                    </dd>

                    <dt class="col-sm-4 text-muted fw-normal">Date</dt>
                    <dd class="col-sm-8 fw-semibold">
                        <i class="bi bi-calendar3 me-2 text-success"></i>
                        {{ appointment.appointmentDate|date('l d F Y') }}
                    </dd>

                    <dt class="col-sm-4 text-muted fw-normal">Heure de début</dt>
                    <dd class="col-sm-8 fw-semibold">
                        <i class="bi bi-clock me-2 text-success"></i>
                        {{ appointment.startTime|date('H:i') }}
                    </dd>

                    <dt class="col-sm-4 text-muted fw-normal">Heure de fin</dt>
                    <dd class="col-sm-8 fw-semibold">
                        <i class="bi bi-clock-history me-2 text-secondary"></i>
                        {{ appointment.endTime|date('H:i') }}
                    </dd>

                    <dt class="col-sm-4 text-muted fw-normal">Durée</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-light text-dark border">
                            {{ appointment.service.appointmentDuration ?? 20 }} minutes
                        </span>
                    </dd>

                    {% if appointment.notes %}
                    <dt class="col-sm-4 text-muted fw-normal">Notes</dt>
                    <dd class="col-sm-8">
                        <div class="p-3 bg-light rounded border-start border-warning border-3">
                            <i class="bi bi-sticky me-2 text-warning"></i>{{ appointment.notes }}
                        </div>
                    </dd>
                    {% endif %}

                    <dt class="col-sm-4 text-muted fw-normal">Réservé le</dt>
                    <dd class="col-sm-8 text-muted">
                        <i class="bi bi-clock-history me-1"></i>
                        {{ appointment.createdAt|date('d/m/Y à H:i') }}
                    </dd>
                </dl>
            </div>
        </div>

        {# Cancel form – only for upcoming confirmed appointments #}
        {% if appointment.status == 'confirmed' and appointment.isUpcoming() %}
        <div class="card card-shadow mt-4 border-warning">
            <div class="card-body p-4">
                <h6 class="fw-semibold text-warning mb-3">
                    <i class="bi bi-exclamation-triangle me-2"></i>Annuler ce rendez-vous
                </h6>
                <p class="text-muted mb-3">
                    Si vous ne pouvez pas honorer ce rendez-vous, vous pouvez l'annuler. 
                    Le créneau sera libéré pour d'autres clients.
                </p>
                <form action="{{ path('client_appointment_cancel', {id: appointment.id}) }}" method="POST"
                      onsubmit="return confirm('Êtes-vous sûr(e) de vouloir annuler ce rendez-vous ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('cancel-appointment-' ~ appointment.id) }}">
                    <button type="submit" class="btn btn-warning">
                        <i class="bi bi-x-circle me-2"></i>Annuler ce rendez-vous
                    </button>
                </form>
            </div>
        </div>
        {% endif %}
    </div>

    <div class="col-lg-4">
        {# Service info card #}
        <div class="card card-shadow mb-4">
            <div class="card-header bg-primary text-white py-3">
                <h6 class="card-title mb-0">
                    <i class="bi bi-layers me-2"></i>Service concerné
                </h6>
            </div>
            <div class="card-body p-4">
                <h5 class="fw-bold">{{ appointment.service.name }}</h5>
                {% if appointment.service.description %}
                    <p class="text-muted small mb-3">{{ appointment.service.description }}</p>
                {% endif %}
                <div class="d-flex flex-column gap-2">
                    <div class="d-flex justify-content-between small">
                        <span class="text-muted">Code service :</span>
                        <code>{{ appointment.service.code }}</code>
                    </div>
                    <div class="d-flex justify-content-between small">
                        <span class="text-muted">Statut :</span>
                        {% if appointment.service.isActive() %}
                            <span class="badge bg-success">Actif</span>
                        {% else %}
                            <span class="badge bg-secondary">Inactif</span>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        {# Quick actions #}
        <div class="card card-shadow">
            <div class="card-header bg-white py-3">
                <h6 class="card-title mb-0 fw-semibold">
                    <i class="bi bi-lightning me-2 text-warning"></i>Actions rapides
                </h6>
            </div>
            <div class="card-body p-3 d-grid gap-2">
                <a href="{{ path('client_appointment_index') }}" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-list-ul me-1"></i>Tous mes rendez-vous
                </a>
                <a href="{{ path('client_appointment_slots') }}" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-calendar-plus me-1"></i>Prendre un nouveau RDV
                </a>
                <a href="{{ path('client_dashboard') }}" class="btn btn-outline-success btn-sm">
                    <i class="bi bi-house me-1"></i>Tableau de bord
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
