{% extends 'base.html.twig' %}

{% block title %}Mes Tickets – QueueLess{% endblock %}

{% block body %}
<div class="py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a href="{{ path('client_dashboard') }}">Mon Espace</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Tickets</li>
                </ol>
            </nav>
            <h2 class="fw-bold mb-0"><i class="bi bi-ticket-perforated text-primary me-2"></i> Historique de mes tickets</h2>
        </div>
        <a href="{{ path('client_ticket_request') }}" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Prendre un nouveau ticket
        </a>
    </div>

    <div class="card card-shadow bg-white">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">Tous mes tickets enregistrés <span class="badge bg-secondary ms-1">{{ tickets|length }}</span></h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Numéro</th>
                            <th>Service</th>
                            <th>Date d'émission</th>
                            <th>Guichet</th>
                            <th>Statut</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for t in tickets %}
                            <tr>
                                <td>
                                    <span class="fw-bold font-monospace text-primary fs-6">{{ t.ticketNumber }}</span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">{{ t.service.code }}</span>
                                    {{ t.service.name }}
                                </td>
                                <td class="small text-muted">{{ t.createdAt|date('d/m/Y H:i') }}</td>
                                <td>
                                    {{ t.counter ? t.counter.name : '<span class="text-muted small">Non attribué</span>'|raw }}
                                </td>
                                <td>
                                    <span class="badge {{ t.statusBadgeClass }}">{{ t.statusLabel }}</span>
                                </td>
                                <td class="text-end">
                                    <a href="{{ path('client_ticket_show', {id: t.id}) }}" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye me-1"></i> Suivre
                                    </a>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center text-muted p-4">
                                    Vous n'avez pas encore demandé de ticket.
                                    <div class="mt-2">
                                        <a href="{{ path('client_ticket_request') }}" class="btn btn-sm btn-primary">Prendre un premier ticket</a>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
