{% extends 'base.html.twig' %}

{% block title %}Ticket {{ ticket.ticketNumber }} – QueueLess{% endblock %}

{% block body %}
<div class="py-3">
    <div class="mb-3 d-flex justify-content-between align-items-center">
        <a href="{{ path('client_dashboard') }}" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Mon tableau de bord
        </a>
        <a href="{{ path('client_ticket_list') }}" class="btn btn-light border btn-sm">
            <i class="bi bi-clock-history me-1"></i> Historique de mes tickets
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <!-- Ticket Card (Academic & Professional representation) -->
            <div class="card card-shadow bg-white text-center p-4 border-top border-5 border-primary position-relative overflow-hidden">
                <div class="text-muted small text-uppercase fw-bold tracking-wider mb-1">QueueLess – Ticket de passage</div>
                <div class="text-secondary small mb-3">{{ ticket.service.name }}</div>

                <!-- Big Ticket Number (US05) -->
                <div class="p-3 my-2 bg-light rounded border border-dashed">
                    <span class="text-muted small d-block">VOTRE NUMÉRO</span>
                    <h1 class="display-3 fw-bolder text-primary mb-0 letter-spacing-2 font-monospace">{{ ticket.ticketNumber }}</h1>
                    <span class="badge {{ ticket.statusBadgeClass }} mt-2 px-3 py-1 fs-6">
                        {{ ticket.statusLabel }}
                    </span>
                </div>

                <!-- Status details banner -->
                {% if ticket.status == 'waiting' %}
                    <div class="alert alert-info text-start my-3 p-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; font-size: 1.5rem;">
                                {{ position }}
                            </div>
                            <div>
                                <h6 class="fw-bold mb-0">Votre position dans la file : <span class="text-primary">{{ position }}{{ position == 1 ? 'er' : 'ème' }}</span></h6>
                                <div class="small text-secondary">
                                    {{ peopleAhead == 0 ? "Vous êtes le prochain usager à être appelé !" : peopleAhead ~ " personne(s) avant vous." }}
                                </div>
                            </div>
                        </div>
                        <hr class="my-2">
                        <div class="small text-muted d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-hourglass-split me-1"></i> Temps d'attente estimé :</span>
                            <strong class="text-dark">~ {{ estimatedWaitMinutes }} minutes</strong>
                        </div>
                    </div>
                {% elseif ticket.status == 'called' %}
                    <div class="alert alert-warning text-center my-3 p-4 border-2 border-warning">
                        <i class="bi bi-megaphone-fill fs-1 text-warning d-block mb-2"></i>
                        <h4 class="fw-bold text-dark mb-1">C'EST VOTRE TOUR !</h4>
                        <p class="mb-0 fs-5">
                            Veuillez vous présenter immédiatement au :<br>
                            <span class="badge bg-dark fs-5 mt-1 px-3 py-2">{{ ticket.counter ? ticket.counter.name : 'Guichet' }}</span>
                        </p>
                    </div>
                {% elseif ticket.status == 'in_progress' %}
                    <div class="alert alert-primary text-center my-3 p-3">
                        <i class="bi bi-gear-fill fs-2 text-primary d-block mb-1"></i>
                        <h5 class="fw-bold mb-1">Traitement en cours</h5>
                        <p class="small mb-0">Votre passage est actuellement pris en charge par un agent au <strong>{{ ticket.counter ? ticket.counter.name : 'guichet' }}</strong>.</p>
                    </div>
                {% elseif ticket.status == 'completed' %}
                    <div class="alert alert-success text-center my-3 p-3">
                        <i class="bi bi-check-circle-fill fs-2 text-success d-block mb-1"></i>
                        <h5 class="fw-bold mb-1">Passage terminé</h5>
                        <p class="small mb-0">Merci de votre visite ! Votre démarche a été traitée avec succès.</p>
                    </div>
                {% elseif ticket.status == 'absent' %}
                    <div class="alert alert-danger text-center my-3 p-3">
                        <i class="bi bi-person-x-fill fs-2 text-danger d-block mb-1"></i>
                        <h5 class="fw-bold mb-1">Client absent</h5>
                        <p class="small mb-0">Votre numéro a été appelé au guichet mais aucune présence n'a été constatée.</p>
                    </div>
                {% endif %}

                <!-- Ticket metadata (US05) -->
                <div class="table-responsive small text-start border rounded mt-2">
                    <table class="table table-sm table-borderless mb-0">
                        <tbody>
                            <tr>
                                <th class="text-muted ps-3 py-2">Service :</th>
                                <td class="fw-semibold py-2">{{ ticket.service.name }} ({{ ticket.service.code }})</td>
                            </tr>
                            <tr>
                                <th class="text-muted ps-3 py-2">Demandeur :</th>
                                <td class="py-2">{{ ticket.client.fullName }}</td>
                            </tr>
                            <tr>
                                <th class="text-muted ps-3 py-2">Date d'émission :</th>
                                <td class="py-2">{{ ticket.createdAt|date('d/m/Y à H:i:s') }}</td>
                            </tr>
                            {% if ticket.calledAt %}
                                <tr>
                                    <th class="text-muted ps-3 py-2">Appelé à :</th>
                                    <td class="py-2">{{ ticket.calledAt|date('H:i:s') }}</td>
                                </tr>
                            {% endif %}
                            {% if ticket.counter %}
                                <tr>
                                    <th class="text-muted ps-3 py-2">Guichet assigné :</th>
                                    <td class="fw-semibold text-primary py-2">{{ ticket.counter.name }} ({{ ticket.counter.code }})</td>
                                </tr>
                            {% endif %}
                        </tbody>
                    </table>
                </div>

                <div class="mt-4 pt-3 border-top d-flex gap-2 justify-content-center">
                    <button class="btn btn-outline-secondary btn-sm" onclick="window.location.reload();">
                        <i class="bi bi-arrow-clockwise me-1"></i> Actualiser ma position
                    </button>
                    <button class="btn btn-light border btn-sm" onclick="window.print();">
                        <i class="bi bi-printer me-1"></i> Imprimer le ticket
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
